# ==============================================================================
# Flutter / Dart Core Exclusions
# ==============================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/

# ==============================================================================
# Local Databases & Dev State (SQLite)
# ==============================================================================
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==============================================================================
# Android Native Exclusions
# ==============================================================================
.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/local.properties
android/key.properties
android/bundle/
*.apk
*.aab

# ==============================================================================
# iOS / macOS Native Exclusions
# ==============================================================================
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner.xcworkspace/
**/ios/Pods/
**/ios/Podfile.lock
**/DerivedData/

# ==============================================================================
# Desktop Ephemeral Exclusions (Windows, Linux, macOS)
# ==============================================================================
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/

# ==============================================================================
# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.appleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ==============================================================================
# IDEs & Code Editors
# ==============================================================================
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary & Swap Files
*.swp
*.swo
*.tmp
*.bak
*.log
